{
  "openapi": "3.0.0",
  "paths": {
    "/users/register": {
      "post": {
        "operationId": "UsersController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "User data transfer object containing user details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddUserDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "return a ReturnedUserDTO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: User with the same email already exists"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "summary": "Registers a new user by validating the received user data",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/login": {
      "post": {
        "operationId": "UsersController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "User data transfer object containing email and password",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "return a ReturnedUserDTO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          },
          "404": {
            "description": "Not Found: User not found"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "summary": "Logs in a user by verifying the email and password",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "UsersController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "return a ReturnedUserDTO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized: User not authenticated"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "summary": "Retrieves the current user's information",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/all-users": {
      "get": {
        "operationId": "UsersController_getAllUsers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "return an array of UserDTO",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDTO"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized: User not authenticated"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "summary": "Get all users",
        "tags": [
          "Users"
        ]
      }
    }
  },
  "info": {
    "title": "Nest.jsc Application",
    "description": "API documentation for Nest.js Application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AddUserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unique identifier for the user"
          },
          "firstname": {
            "type": "string",
            "example": "John",
            "description": "First name of the user"
          },
          "lastname": {
            "type": "string",
            "example": "Doe",
            "description": "Last name of the user"
          },
          "email": {
            "type": "string",
            "example": "john.doe@nest.dev",
            "description": "Email address of the user"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "Password for the user account"
          }
        },
        "required": [
          "id",
          "firstname",
          "lastname",
          "email",
          "password"
        ]
      },
      "UserDTO": {
        "type": "object",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-02-12T19:40:26.430Z",
            "description": "Creation timestamp"
          },
          "createdBy": {
            "type": "string",
            "example": "system",
            "description": "Creator of the entity"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-02-12T19:40:26.430Z",
            "description": "Last update timestamp"
          },
          "updatedBy": {
            "type": "string",
            "example": "system",
            "description": "Last updater of the entity"
          },
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unique identifier for the user"
          },
          "firstname": {
            "type": "string",
            "example": "John",
            "description": "First name of the user"
          },
          "lastname": {
            "type": "string",
            "example": "Doe",
            "description": "Last name of the user"
          },
          "email": {
            "type": "string",
            "example": "john.doe@nest.dev"
          },
          "role": {
            "type": "number",
            "example": 100,
            "description": "Role of the user"
          },
          "token": {
            "type": "string",
            "example": "mySuperToken",
            "description": "Password for the user account"
          }
        },
        "required": [
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "id",
          "firstname",
          "lastname",
          "email",
          "role",
          "token"
        ]
      },
      "LoginUserDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john.doe@nest.dev"
          },
          "password": {
            "type": "string",
            "example": "password1234",
            "description": "Password for the user account"
          }
        },
        "required": [
          "email",
          "password"
        ]
      }
    }
  }
}